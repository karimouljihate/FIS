new file mode 100644
--- /dev/null
+++ b/irrigation/utils/geojson.py
@@ -0,0 +1,72 @@
+"""Shared GeoJSON validation helpers.
+
+Geometry accepted by FIS is stored as WGS84 GeoJSON and validated with
+Shapely before it reaches engineering/projection code.
+"""
+from math import isfinite
+
+from shapely.geometry import shape
+
+
+SUPPORTED_GEOMETRY_TYPES = {
+    'Point',
+    'LineString',
+    'Polygon',
+    'MultiPoint',
+    'MultiLineString',
+    'MultiPolygon',
+}
+
+
+def validate_geojson_geometry(geometry, *, polygon_only=False):
+    """Return ``(True, None)`` for valid GeoJSON geometry.
+
+    The second item contains a user-safe validation message when invalid.
+    """
+    if not isinstance(geometry, dict):
+        return False, 'Geometry must be a JSON object'
+
+    geom_type = geometry.get('type')
+    if geom_type not in SUPPORTED_GEOMETRY_TYPES:
+        return False, f'Unsupported geometry type: {geom_type}'
+
+    if 'coordinates' not in geometry:
+        return False, 'Geometry coordinates are required'
+
+    if polygon_only and geom_type not in {'Polygon', 'MultiPolygon'}:
+        return False, 'A polygon geometry is required'
+
+    try:
+        geom = shape(geometry)
+    except (TypeError, ValueError):
+        return False, 'Invalid geometry coordinates'
+
+    if geom.is_empty:
+        return False, 'Geometry cannot be empty'
+    if not geom.is_valid:
+        return False, 'Geometry is not valid'
+
+    # Reject NaN/Infinity coordinates explicitly.  Shapely can construct
+    # objects containing them, but pyproj/GeoJSON clients cannot safely use
+    # them for engineering calculations.
+    def check_coords(coords):
+        if isinstance(coords, (list, tuple)):
+            if coords and all(isinstance(v, (int, float)) for v in coords):
+                return len(coords) >= 2 and all(isfinite(v) for v in coords)
+            return all(check_coords(child) for child in coords)
+        return False
+
+    if not check_coords(geometry['coordinates']):
+        return False, 'Geometry contains invalid coordinate values'
+
+    return True, None
+
+
+def ensure_polygon(geometry):
+    """Validate a polygon and raise ValueError with a safe message if invalid."""
+    valid, message = validate_geojson_geometry(geometry, polygon_only=True)
+    if not valid:
+        raise ValueError(message)
+    return geometry

