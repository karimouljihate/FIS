+@project_bp.route('/create', methods=['GET', 'POST'])

+@login_required

+def create():

+    if request.method == 'POST':

+        name = request.form.get('name', '').strip()

+        description = request.form.get('description', '').strip()

+

+        if not name:

+            flash('Project name is required / اسم المشروع مطلوب', 'danger')

+            return render_template('project/create.html')

+

+        project_id = get_next_id('projects')

+        project_doc = {

+            'id': project_id,

+            'user_id': int(current_user.id),

+            'name': name,

+            'location': request.form.get('location', '').strip(),

+            'description': description,

+            'water_source': {},

+            'boundary': None,

+            'kml_file': None,

+            'source_file': None,

+            'land': {},

+            'owner': {},

+            'configuration': {},

+            'rules': {},

+            'tree_plans': [],

+            'setup': {

+                'project': True,

+                'land': False,

+                'owner': False,

+                'configuration': False,

+                'rules': False,

+                'tree_plan': False

+            },

+            'status': 'draft',

+            'created_at': datetime.utcnow()

+        }

+

+        try:

+            water_lat = request.form.get('water_source_lat', '').strip()

+            water_lng = request.form.get('water_source_lng', '').strip()

+            if water_lat or water_lng:

+                if not water_lat or not water_lng:

+                    raise ValueError('Both water source coordinates are required.')

+                lat = float(water_lat)

+                lng = float(water_lng)

+                if not (-90 <= lat <= 90 and -180 <= lng <= 180):

+                    raise ValueError('Water source coordinates are outside valid ranges.')

+                project_doc['water_source'] = {

+                    'type': 'Point',

+                    'coordinates': [lng, lat]

+                }

+

+            boundary_coords = request.form.get('boundary_coords', '').strip()

+            if boundary_coords:

+                coords = json.loads(boundary_coords)

+                if not isinstance(coords, list) or len(coords) < 4 or coords[0] != coords[-1]:

+                    raise ValueError('Boundary must contain at least 4 points and be closed.')

+                project_doc['boundary'] = {

+                    'type': 'Polygon',

+                    'coordinates': [coords]

+                }

+                project_doc['land'] = build_land_summary(

+                    project_doc['boundary'],

+                    project_doc['water_source'] or None,

+                    None,

+                    'manual'

+                )

+                project_doc['setup']['land'] = True

+

+            mongo.db.projects.insert_one(project_doc)

+

+            uploaded = request.files.get('project_file')

+            if uploaded and uploaded.filename:

+                _save_project_file(project_id, project_doc, uploaded)

+                project_doc = mongo.db.projects.find_one({'id': project_id})

+

+            flash('Project created successfully / تم إنشاء المشروع بنجاح', 'success')

+            return redirect(url_for('project.detail', project_id=project_id))

+

+        except (ValueError, json.JSONDecodeError) as exc:

+            mongo.db.projects.delete_one({'id': project_id, 'user_id': int(current_user.id)})

+            flash(f'Project creation failed: {exc}', 'danger')

+            return render_template('project/create.html')

+        except Exception as exc:

+            mongo.db.projects.delete_one({'id': project_id, 'user_id': int(current_user.id)})

+            current_app.logger.exception('Project creation/import failed')

+            flash(f'Project creation failed: {exc}', 'danger')

+            return render_template('project/create.html')

+

+    return render_template('project/create.html')

+

+

