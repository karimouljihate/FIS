+"""Land geometry extraction and summary helpers for Project setup."""

+from shapely.geometry import shape, mapping

+from shapely.ops import transform

+from pyproj import CRS, Transformer

+

+

+def _metric_transformer(geometry):

+    centroid = geometry.centroid

+    lon = centroid.x

+    lat = centroid.y

+    zone = int((lon + 180) / 6) + 1

+    epsg = 32600 + zone if lat >= 0 else 32700 + zone

+    transformer = Transformer.from_crs(

+        CRS.from_epsg(4326), CRS.from_epsg(epsg), always_xy=True

+    )

+    return transformer

+

+

+def build_land_summary(boundary=None, water_source=None,

+                       source_file=None, source_type=None):

+    result = {

+        'boundary': boundary,

+        'area_m2': None,

+        'area_ha': None,

+        'perimeter_m': None,

+        'centroid': None,

+        'geometry_status': 'not_set',

+        'source_file': (

+            {'name': source_file, 'type': source_type}

+            if source_file else None

+        )

+    }

+    if not boundary:

+        return result

+

+    try:

+        geometry = shape(boundary)

+        if geometry.is_empty:

+            return result

+

+        if geometry.geom_type not in ('Polygon', 'MultiPolygon'):

+            result['geometry_status'] = 'invalid_type'

+            return result

+

+        result['geometry_status'] = 'valid' if geometry.is_valid else 'invalid'

+        result['centroid'] = mapping(geometry.centroid)

+

+        transformer = _metric_transformer(geometry)

+        metric_geometry = transform(transformer.transform, geometry)

+        result['area_m2'] = round(metric_geometry.area, 2)

+        result['area_ha'] = round(metric_geometry.area / 10000.0, 4)

+        result['perimeter_m'] = round(metric_geometry.length, 2)

+    except Exception:

+        result['geometry_status'] = 'invalid'

+

+    return result

