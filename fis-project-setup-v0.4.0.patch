+"""AutoCAD DXF import helpers for Project setup.

+

+DXF coordinates are treated as WGS84 longitude/latitude coordinates.

+For projected/local CAD drawings, the user should georeference/convert the

+drawing to WGS84 before importing.

+"""

+import ezdxf

+from shapely.geometry import Point, LineString, Polygon, mapping

+

+

+def _entity_geometry(entity):

+    dxftype = entity.dxftype()

+

+    if dxftype == 'POINT':

+        p = entity.dxf.location

+        return Point(p.x, p.y)

+

+    if dxftype == 'LINE':

+        start = entity.dxf.start

+        end = entity.dxf.end

+        return LineString([(start.x, start.y), (end.x, end.y)])

+

+    if dxftype == 'LWPOLYLINE':

+        points = [(p[0], p[1]) for p in entity.get_points()]

+        if len(points) < 2:

+            return None

+        closed = bool(entity.closed)

+        if closed and len(points) >= 3:

+            return Polygon(points)

+        return LineString(points)

+

+    if dxftype == 'POLYLINE':

+        points = [

+            (vertex.dxf.location.x, vertex.dxf.location.y)

+            for vertex in entity.vertices

+        ]

+        if len(points) < 2:

+            return None

+        closed = bool(entity.is_closed)

+        if closed and len(points) >= 3:

+            return Polygon(points)

+        return LineString(points)

+

+    return None

+

+

+def parse_dxf_file(path):

+    document = ezdxf.readfile(path)

+    modelspace = document.modelspace()

+    features = []

+

+    for index, entity in enumerate(modelspace):

+        try:

+            geometry = _entity_geometry(entity)

+        except Exception:

+            continue

+        if geometry is None or geometry.is_empty:

+            continue

+

+        features.append({

+            'name': entity.dxf.layer or f'DXF {index + 1}',

+            'geometry': mapping(geometry),

+            'source': 'dxf',

+            'entity_type': entity.dxftype()

+        })

+

+    return features

